        vars, earth, lmtest, sandwich, progressr, future, future.apply,
        rlang, magrittr, parallel, stats, utils
Suggests: bsts, BoomSpikeSlab, knitr, cmdstanr, rstan, RhpcBLASctl,
        rmarkdown, testthat (>= 3.2.0)
