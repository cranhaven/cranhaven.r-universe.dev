\subsection{\code{iglm.data$geodesic_distances_distribution()}}{
  Calculates the geodesic distance distribution of the symmetrized
`z_network`.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{iglm.data$geodesic_distances_distribution(
  value_range = NULL,
