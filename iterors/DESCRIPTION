Package: iterors
Type: Package
Title: Fast, Compact Iterators and Tools
Version: 1.0.1
Maintainer: Peter Meilstrup <peter.meilstrup@gmail.com>
Authors@R: c(person("Peter", "Meilstrup", role=c("cre", "aut", "cph"),
        email="peter.meilstrup@gmail.com"), person("Folashade",
        "Daniel", role="aut"), person("Revolution Analytics",
