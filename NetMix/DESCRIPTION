Package: NetMix
Type: Package
Title: Dynamic Mixed-Membership Network Regression Model
Version: 0.2.0.3
Date: 2025-06-04
Encoding: UTF-8
Authors@R: c(person(given = "Santiago", family = "Olivella", role =
        c("aut", "cre"), email = "olivella@unc.edu"), person(given =
